# --- Clean shell for container commands (prevents host env leaking into container) ---
cleanenv () {
  if command -v module >/dev/null 2>&1; then
    module purge 2>/dev/null || true
  fi
  if type conda &>/dev/null; then
    # Deactivate all nested conda environments.
    while [[ "$(conda info --json | sed -n 's/.*\"active_prefix\": \"\(.*\)\".*/\1/p')" != "" ]]; do
      conda deactivate || break
    done
  fi
  unset PYTHONPATH
}

