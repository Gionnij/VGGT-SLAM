# Utility: best-effort CUDA binding (Slurm-aware, falls back to utilisation-based pick).
_vggt_bind_gpu () {
  local auto_pick="${AUTO_PICK_GPU:-1}"
  export CUDA_DEVICE_ORDER=PCI_BUS_ID

  if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
    return
  fi

  local slurm_gpus="${SLURM_STEP_GPUS:-${SLURM_JOB_GPUS:-}}"
  if [ -n "$slurm_gpus" ]; then
    slurm_gpus="${slurm_gpus//,/ }"
    if echo "$slurm_gpus" | grep -Eq '^[0-9 ]+$'; then
      export CUDA_VISIBLE_DEVICES="$(echo "$slurm_gpus" | awk '{print $1}')"
    elif command -v nvidia-smi >/dev/null 2>&1; then
      while read -r idx uuid; do
        for u in $slurm_gpus; do
          if [ "$u" = "$uuid" ]; then
            export CUDA_VISIBLE_DEVICES="$idx"
            break 2
          fi
        done
      done < <(nvidia-smi -L | awk -F'[(): ]+' '/UUID/{printf "%s %s\n",$3,$7}')
    fi
  fi

  if [ -z "${CUDA_VISIBLE_DEVICES:-}" ] && [ "$auto_pick" = "1" ] && command -v nvidia-smi >/dev/null 2>&1; then
    local best="" bestscore=""
    while IFS=',' read -r idx uuid mem util; do
      idx="${idx//[[:space:]]/}"
      mem="${mem//[[:space:]]/}"
      util="${util//[[:space:]]/}"
      local score
      score=$(printf "%012d-%03d" "$mem" "$util")
      if [ -z "$bestscore" ] || [ "$score" \< "$bestscore" ]; then
        bestscore="$score"
        best="$idx"
      fi
    done < <(nvidia-smi --query-gpu=index,uuid,memory.used,utilization.gpu --format=csv,noheader,nounits 2>/dev/null)
    [ -n "$best" ] && export CUDA_VISIBLE_DEVICES="$best"
  fi
}

