# Pull robot reverse-tunneled TCP stream from HPC head to this node (typically GPU node).
# Usage: hpc_robot_stream_tunnel [local_port] [head_port]
hpc_robot_stream_tunnel () {
  local local_port="${1:-15001}"
  local head_port="${2:-15001}"
  local head_host="${HPC_HEAD_HOST:-hpc-head1.ewi.utwente.nl}"
  local head_user="${HPC_HEAD_USER:-$USER}"
  local head_key="${HPC_HEAD_SSH_KEY:-}"
  local ssh_opts="${HPC_HEAD_SSH_OPTS:- -o IdentitiesOnly=yes -o IdentityAgent=none -o ServerAliveInterval=30 -o ServerAliveCountMax=3}"

  local key_arg=()
  if [ -n "${head_key}" ]; then
    key_arg=( -i "${head_key}" )
  elif [ -f "${HOME}/.ssh/id_ed25519" ]; then
    key_arg=( -i "${HOME}/.ssh/id_ed25519" )
  elif [ -f "${HOME}/.ssh/id_rsa" ]; then
    key_arg=( -i "${HOME}/.ssh/id_rsa" )
  fi

  echo "[hpc_robot_stream_tunnel] Forwarding 127.0.0.1:${local_port} -> ${head_host}:127.0.0.1:${head_port}"
  echo "[hpc_robot_stream_tunnel] Keep this terminal open; Ctrl+C to stop."
  # shellcheck disable=SC2086
  ssh ${ssh_opts} "${key_arg[@]}" -N -L "127.0.0.1:${local_port}:127.0.0.1:${head_port}" "${head_user}@${head_host}"
}

# Run TCP->ROS2 bridge on HPC (typically GPU node) using run_vggt-compatible topics.
# Usage: hpc_robot_bridge [tcp_host] [tcp_port] [fps]
hpc_robot_bridge () {
  cleanenv 2>/dev/null || true
  if command -v module >/dev/null 2>&1; then
    module load singularity/3.9.5 2>/dev/null || true
  fi

  local tcp_host="${1:-127.0.0.1}"
  local tcp_port="${2:-15001}"
  local fps="${3:-2.0}"
  local stats_interval="${HPC_ROBOT_STATS_INTERVAL:-5.0}"
  local save_every="${HPC_ROBOT_SAVE_EVERY:-0}"
  local save_dir="${HPC_ROBOT_SAVE_DIR:-$HOME/src/VGGT-SLAM/robot_probe_frames}"
  local use_fastdds_xml="${HPC_BRIDGE_USE_FASTDDS_XML:-0}"
  local undistort="${HPC_ROBOT_UNDISTORT:-0}"
  local undistort_alpha="${HPC_ROBOT_UNDISTORT_ALPHA:-0.0}"
  local fx="${HPC_ROBOT_FX:--1.0}"
  local fy="${HPC_ROBOT_FY:--1.0}"
  local cx="${HPC_ROBOT_CX:--1.0}"
  local cy="${HPC_ROBOT_CY:--1.0}"
  local k1="${HPC_ROBOT_K1:-0.0}"
  local k2="${HPC_ROBOT_K2:-0.0}"
  local p1="${HPC_ROBOT_P1:-0.0}"
  local p2="${HPC_ROBOT_P2:-0.0}"
  local k3="${HPC_ROBOT_K3:-0.0}"
  local undistort_args=""
  if [ "${undistort}" = "1" ]; then
    undistort_args="--undistort --undistort-alpha ${undistort_alpha} --fx ${fx} --fy ${fy} --cx ${cx} --cy ${cy} --k1 ${k1} --k2 ${k2} --p1 ${p1} --p2 ${p2} --k3 ${k3}"
  fi
  local SIF="${HOME}/containers/ros_humble_perception.sif"

  singularity exec --cleanenv "${SIF}" bash -lc "
    set -eE -o pipefail
    set +u; source /opt/ros/humble/setup.bash; set -u

    export ROS_DOMAIN_ID=42
    export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
    export ROS_LOCALHOST_ONLY=0
    if [ \"${use_fastdds_xml}\" = \"1\" ] && [ -f \"\$HOME/.fastdds_unicast_runtime.xml\" ]; then
      export FASTDDS_DEFAULT_PROFILES_FILE=\"\$HOME/.fastdds_unicast_runtime.xml\"
      export FASTRTPS_DEFAULT_PROFILES_FILE=\"\$HOME/.fastdds_unicast_runtime.xml\"
    fi

    python3 ${VGGT_SLAM_ROOT}/unitree_tcp_ros2_bridge.py \
      --robot-ip ${tcp_host} \
      --port ${tcp_port} \
      --fps ${fps} \
      --image-topic /camera/image_color \
      --info-topic /camera/camera_info \
      --frame-id camera \
      --max-width 960 \
      --max-height 540 \
      --stats-interval ${stats_interval} \
      --save-every ${save_every} \
      --save-dir ${save_dir} \
      ${undistort_args}
  "
}

# Shared state file used by head/compute scripts to exchange active GPU endpoint info.
hpc_gpu_state_file () {
  echo "${VGGT_GPU_STATE_FILE:-$HOME/.vggt_active_gpu.env}"
}

# Record current node identity/IP so head-side services can target it.
hpc_record_gpu_state () {
  local node ip file run_id
  node="$(hostname -s 2>/dev/null || hostname)"
  ip="$(hostname -I 2>/dev/null | tr ' ' '\n' | awk '
    /^10[.]/ {print; found=1; exit}
    { if ($0 != "") first=$0 }
    END {
      if (!found && first != "") print first
      else if (!found) print "127.0.0.1"
    }')"
  file="$(hpc_gpu_state_file)"
  run_id="${HPC_GPU_RUN_ID:-${VGGT_GPU_RUN_ID:-}}"
  cat > "${file}" <<EOF
GPU_NODE=${node}
GPU_IP=${ip}
GPU_RUN_ID=${run_id}
UPDATED_AT=$(date +%s)
EOF
  echo "[hpc_record_gpu_state] ${node} (${ip}) run_id=${run_id:-none} -> ${file}"
}

# Run bridge on head node and configure FastDDS unicast peer using the latest GPU state file.
# Usage: hpc_head_bridge [head_port] [fps]
hpc_head_bridge () {
  local head_port="${1:-15001}"
  local fps="${2:-2.0}"
  local wait_s="${HPC_GPU_STATE_WAIT_SEC:-600}"
  local poll_s="${HPC_GPU_STATE_POLL_SEC:-2}"
  local expected_run_id="${HPC_GPU_RUN_ID:-${VGGT_GPU_RUN_ID:-}}"
  local state_file
  state_file="$(hpc_gpu_state_file)"

  local elapsed=0
  while :; do
    if [ ! -f "${state_file}" ]; then
      if [ "${elapsed}" -ge "${wait_s}" ]; then
        echo "[hpc_head_bridge] Timed out waiting for GPU state file: ${state_file}" >&2
        return 1
      fi
      echo "[hpc_head_bridge] Waiting for GPU state file (${elapsed}s/${wait_s}s): ${state_file}"
      sleep "${poll_s}"
      elapsed=$((elapsed + poll_s))
      continue
    fi

    # shellcheck disable=SC1090
    source "${state_file}"
    if [ -z "${GPU_IP:-}" ]; then
      echo "[hpc_head_bridge] Invalid state file (missing GPU_IP): ${state_file}" >&2
      sleep "${poll_s}"
      elapsed=$((elapsed + poll_s))
      continue
    fi
    if [ -n "${expected_run_id}" ] && [ "${GPU_RUN_ID:-}" != "${expected_run_id}" ]; then
      if [ "${elapsed}" -ge "${wait_s}" ]; then
        echo "[hpc_head_bridge] Timed out waiting for matching run_id='${expected_run_id}' in ${state_file}" >&2
        return 1
      fi
      echo "[hpc_head_bridge] Waiting for matching run_id='${expected_run_id}' (${elapsed}s/${wait_s}s). Current='${GPU_RUN_ID:-none}'"
      sleep "${poll_s}"
      elapsed=$((elapsed + poll_s))
      continue
    fi
    break
  done

  local head_ip
  head_ip="$(hostname -I 2>/dev/null | tr ' ' '\n' | awk '
    /^10[.]/ {print; found=1; exit}
    { if ($0 != "") first=$0 }
    END {
      if (!found && first != "") print first
      else if (!found) print "130.89.6.254"
    }')"

  cat > "${HOME}/.fastdds_unicast_runtime.xml" <<EOF
<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="unicast_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>udp_only</transport_id></userTransports>
      <builtin>
        <initialPeersList>
          <locator><udpv4><address>${head_ip}</address></udpv4></locator>
          <locator><udpv4><address>${GPU_IP}</address></udpv4></locator>
        </initialPeersList>
        <avoid_builtin_multicast>true</avoid_builtin_multicast>
      </builtin>
    </rtps>
  </participant>
</profiles>
EOF

  echo "[hpc_head_bridge] Using GPU peer ${GPU_IP} (node=${GPU_NODE:-unknown}, run_id=${GPU_RUN_ID:-none})"
  export HPC_BRIDGE_USE_FASTDDS_XML=1
  hpc_robot_bridge 127.0.0.1 "${head_port}" "${fps}"
}

